{
  "manifest_version": 3,
  "name": "ThunderQuail",
  "version": "0.16.0",
  "description": "A local-first AI assistant for Thunderbird.",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderquail@thunderquail.local",
      "strict_min_version": "128.0",
      "update_url": "https://thdiaman.github.io/thunderquail/updates.json"
    }
  },
  "permissions": ["storage", "messagesRead", "compose", "scripting", "accountsRead", "accountsFolders", "messagesMove", "alarms"],
  "background": {
    "scripts": ["background.mjs"],
    "type": "module"
  },
  "host_permissions": ["http://*/*", "https://*/*"],
  "experiment_apis": {
    "quailOverlay": {
      "schema": "overlay/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["quailOverlay"]],
        "script": "overlay/implementation.js",
        "events": ["startup"]
      }
    }
  },
  "compose_action": {
    "default_title": "ThunderQuail",
    "default_popup": "compose.html"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
